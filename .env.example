# Required runtime configuration
DISCORD_TOKEN=
SEFBOT_PRIVACY_CONTACT=

# Public legal/health service. PORT defaults to 8080.
PORT=8080
SEFBOT_WEB_HOST=0.0.0.0
# Generate a long random value (for example: `python -c 'import secrets; print(secrets.token_urlsafe(32))'`).
SEFBOT_DASHBOARD_TOKEN=
# Public account sign-in. The normal flow is Firebase account -> Discord authorization.
SEFBOT_DASHBOARD_PUBLIC_URL=https://wearegays.net
# Generate a separate random value of at least 32 characters. Never expose it in client code.
SEFBOT_DASHBOARD_SESSION_SECRET=
SEFBOT_FIREBASE_API_KEY=
SEFBOT_FIREBASE_AUTH_DOMAIN=
SEFBOT_FIREBASE_PROJECT_ID=
SEFBOT_FIREBASE_APP_ID=
# OAuth2 redirect URI: https://wearegays.net/dashboard/auth/discord/callback
SEFBOT_DISCORD_CLIENT_ID=
SEFBOT_DISCORD_CLIENT_SECRET=

# Optional free social developer integrations. Never put these in dashboard JSON.
SEFBOT_TWITCH_CLIENT_ID=
SEFBOT_TWITCH_CLIENT_SECRET=
SEFBOT_KICK_CLIENT_ID=
SEFBOT_KICK_CLIENT_SECRET=
# A creator-authorized Display API token with video.list for TikTok polling.
SEFBOT_TIKTOK_ACCESS_TOKEN=

# No owner or command synchronization is enabled implicitly.
SEFBOT_OWNER_ID=
SEFBOT_SYNC_COMMANDS=0
SEFBOT_SYNC_GUILDS=

# Provider credentials. Leave unused providers empty.
GROQ_API_KEY=
GROQ_API_KEYS=
SEFBOT_GROQ_BASE_URL=https://api.groq.com/openai/v1
INCEPTION_API_KEY=
MERCURY_API_KEY=
MERCURY_REASONING_EFFORT=instant
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
CELERIS_API_KEY=
CELERIS_BASE_URL=https://inference.celeris.ai/celeris-1/v1
INFERX_API_KEY=
INFERX_BASE_URL=https://model.inferx.net/endpoints/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=ix:deepseek-v4-flash-0731
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEYS=
TAVILY_API_KEY=

# OpenAI-compatible modular provider and model routing.
SEFBOT_LLM_BASE_URL=https://api.example-inference.com/v1
SEFBOT_LLM_API_KEY=
SEFBOT_ALLOW_LOCAL_ENDPOINTS=0
SEFBOT_CHAT_MODEL=gpt-oss-120b
SEFBOT_FAST_MODEL=openai/gpt-oss-20b
SEFBOT_TOOL_MODEL=gpt-oss-20b
SEFBOT_MODEL_VISION=or:nvidia/nemotron-nano-12b-v2-vl:free
SEFBOT_MODEL_BIG=or:nvidia/nemotron-3-ultra-550b-a55b:free
# Optional comma-separated overrides (omitted here to retain built-in defaults):
# SEFBOT_MODEL_VISION_FALLBACKS, SEFBOT_MODEL_BIG_FALLBACKS,
# SEFBOT_MODEL_EXPERT_FALLBACKS, and SEFBOT_MODEL_FALLBACKS.
SEFBOT_VISION_MODEL=qwen-3.6-27b
SEFBOT_SAFETY_MODEL=openai/gpt-oss-20b
SEFBOT_SAFETY_BASE_URL=https://openrouter.ai/api/v1
SEFBOT_SAFETY_API_KEY=
SEFBOT_MULTILINGUAL_MODEL=openai/gpt-oss-20b
SEFBOT_WHISPER_MODEL=whisper-large-v3-turbo
SEFBOT_TTS_MODEL=orpheus-3-0.1b-ft
SEFBOT_TTS_VOICE=tara

# Privacy-first feature defaults. Guild administrators must also opt in through
# guild settings before moderation, rules, history, or transcription can run.
SEFBOT_SAFETY_ENABLED=0
SEFBOT_MODLOG_CHANNEL=
SEFBOT_SAFETY_MIN_INTERVAL=3.0
SEFBOT_SAFETY_MIN_CONFIDENCE=0.85
SEFBOT_MULTILINGUAL_CHANNELS=
SEFBOT_VISION_MAX_IMAGE_BYTES=8000000

SEFBOT_STT_ENABLED=0
SEFBOT_STT_MAX_UTTERANCE_SECONDS=15.0

SEFBOT_RULES_GUILD=
SEFBOT_RULES_ENABLED=0
SEFBOT_RULES_LLM_ENABLED=0
SEFBOT_RULES_LLM_MODEL=openai/gpt-oss-20b
SEFBOT_APPROVAL_CHANNEL=

# Storage and bounded resource settings. Raw history remains off until both the
# guild and the individual user opt in; accepted raw history expires by 30 days.
SEFBOT_DB=sefbot.db
SEFBOT_RETENTION_DAYS=30
SEFBOT_IMPORT_MAX_BYTES=2000000
SEFBOT_AI_MAX_CONCURRENCY=10
SEFBOT_CHAT_MIN_INTERVAL=2.5

# General bot behavior.
SEFBOT_PREFIX=!
SEFBOT_BLOCKED_USERS=
SEFBOT_REFLECT_BATCH=15
SEFBOT_MEMORY_TOPK=10
SEFBOT_KB_TOPK=6
SEFBOT_CHANNEL_CONTEXT=10
SEFBOT_CONVO_TURNS=8
SEFBOT_MEMORY_SOFT_CAP=40
SEFBOT_LESSONS_IN_PROMPT=12
SEFBOT_LURK_MIN_SECONDS=900
SEFBOT_LURK_IDLE_SECONDS=600
SEFBOT_EMBED_COLOR=0x5865F2
# Optional: SEFBOT_PERSONA overrides the entire built-in persona. Omit it to
# retain the default rather than assigning an empty value.
