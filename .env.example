# Required runtime configuration
DISCORD_TOKEN=
# Required for the public legal pages. Use a contact you operate.
OWAUA_PRIVACY_CONTACT=

# Public legal/health service. PORT defaults to 8080.
PORT=8080
OWAUA_WEB_HOST=0.0.0.0
# Separate random values of at least 32 characters. The proxy value must match
# the Cloudflare owaua-path Worker's X-Owaua-Origin-Auth secret.
OWAUA_TOS_ACCEPTANCE_SECRET=
OWAUA_TOS_PROXY_SECRET=
# Discord-only dashboard sign-in.
# Public HTTPS origin for your dashboard, for example https://bot.example.com.
OWAUA_DASHBOARD_PUBLIC_URL=
# Generate a random value of at least 32 characters. Never expose it in client code.
OWAUA_DASHBOARD_SESSION_SECRET=
# OAuth2 redirect URI: https://bot.example.com/dashboard/auth/discord/callback
OWAUA_DISCORD_CLIENT_ID=
OWAUA_DISCORD_CLIENT_SECRET=

# Optional free social developer integrations. Never put these in dashboard JSON.
OWAUA_TWITCH_CLIENT_ID=
OWAUA_TWITCH_CLIENT_SECRET=
OWAUA_KICK_CLIENT_ID=
OWAUA_KICK_CLIENT_SECRET=
# A creator-authorized Display API token with video.list for TikTok polling.
OWAUA_TIKTOK_ACCESS_TOKEN=

# Optional owner, static blocks, and guild-command cleanup. Leave each blank
# unless you deliberately configure it for your own deployment.
OWAUA_OWNER_ID=
OWAUA_SYNC_COMMANDS=0
OWAUA_SYNC_GUILDS=
OWAUA_BLOCKED_USERS=
OWAUA_PUBLIC_WEBSITE_URL=

# Provider credentials. Leave unused providers empty.
GROQ_API_KEY=
GROQ_API_KEYS=
OWAUA_GROQ_BASE_URL=https://api.groq.com/openai/v1
INCEPTION_API_KEY=
MERCURY_API_KEY=
MERCURY_REASONING_EFFORT=instant
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
CELERIS_API_KEY=
CELERIS_BASE_URL=https://inference.celeris.ai/celeris-1/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Official API id for the DeepSeek-V4-Flash-0731 checkpoint.
DEEPSEEK_MODEL=deepseek-v4-flash
INFERX_API_KEY=
INFERX_BASE_URL=https://model.inferx.net/endpoints/v1
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEYS=
TAVILY_API_KEY=

# Optional /nsfw and !nsfw Rule34 integration. Generate these under the
# Rule34 account options page; never expose the API key in Discord or logs.
OWAUA_RULE34_USER_ID=
OWAUA_RULE34_API_KEY=

# OpenAI-compatible modular provider and model routing.
OWAUA_LLM_BASE_URL=https://api.example-inference.com/v1
OWAUA_LLM_API_KEY=
OWAUA_ALLOW_LOCAL_ENDPOINTS=0
OWAUA_CHAT_MODEL=gpt-oss-120b
OWAUA_FAST_MODEL=openai/gpt-oss-20b
OWAUA_TOOL_MODEL=gpt-oss-20b
OWAUA_MODEL_VISION=or:nvidia/nemotron-nano-12b-v2-vl:free
OWAUA_MODEL_BIG=or:nvidia/nemotron-3-ultra-550b-a55b:free
# Optional comma-separated overrides (omitted here to retain built-in defaults):
# OWAUA_MODEL_VISION_FALLBACKS, OWAUA_MODEL_BIG_FALLBACKS,
# OWAUA_MODEL_EXPERT_FALLBACKS, and OWAUA_MODEL_FALLBACKS.
OWAUA_AI_MAX_CONCURRENCY=4
OWAUA_AI_REQUESTS_PER_MINUTE=60
OWAUA_AI_USER_REQUESTS_PER_MINUTE=6
OWAUA_AI_PROVIDER_ATTEMPTS_PER_MINUTE=120
OWAUA_AI_TOKEN_BUDGET_PER_MINUTE=300000
OWAUA_AI_USER_TOKEN_BUDGET_PER_MINUTE=30000
OWAUA_AI_MAX_PROVIDER_ATTEMPTS=4
OWAUA_AI_CONTEXT_MAX_CHARS=48000
OWAUA_AI_CIRCUIT_FAILURES=3
OWAUA_AI_CIRCUIT_COOLDOWN_SECONDS=60
OWAUA_AI_STRUCTURED_REPAIR=1
OWAUA_VISION_MODEL=qwen-3.6-27b
OWAUA_SAFETY_MODEL=openai/gpt-oss-20b
OWAUA_SAFETY_BASE_URL=https://openrouter.ai/api/v1
OWAUA_SAFETY_API_KEY=
OWAUA_MULTILINGUAL_MODEL=openai/gpt-oss-20b
OWAUA_WHISPER_MODEL=whisper-large-v3-turbo
OWAUA_TTS_MODEL=canopylabs/orpheus-v1-english
OWAUA_TTS_VOICE=troy

# Privacy-first feature defaults. Guild administrators must also opt in through
# guild settings before moderation, rules, history, or transcription can run.
OWAUA_SAFETY_ENABLED=0
OWAUA_MODLOG_CHANNEL=
OWAUA_MALWARE_SCAN_ENABLED=1
# Optional absolute path/name when ClamAV is not available as clamdscan/clamscan.
OWAUA_CLAMAV_COMMAND=
OWAUA_CLAMAV_ROOT=.clamav/clamav-1.5.4
OWAUA_CLAMAV_DATABASE_DIR=.clamav/database
OWAUA_CLAMD_CONFIG=.clamav/clamd.conf
OWAUA_FRESHCLAM_CONFIG=.clamav/freshclam.conf
# Private fallback channel for malware incidents, especially infected DMs.
OWAUA_MALWARE_ALERT_CHANNEL=
OWAUA_MALWARE_MAX_FILE_BYTES=104857600
OWAUA_MALWARE_MAX_CONCURRENCY=2
OWAUA_MALWARE_SCAN_TIMEOUT_SECONDS=60
OWAUA_MALWARE_DOWNLOAD_TIMEOUT_SECONDS=30
OWAUA_SAFETY_MIN_INTERVAL=3.0
OWAUA_SAFETY_MIN_CONFIDENCE=0.85
OWAUA_MULTILINGUAL_CHANNELS=
OWAUA_VISION_MAX_IMAGE_BYTES=8000000

OWAUA_STT_ENABLED=0
OWAUA_STT_MAX_UTTERANCE_SECONDS=15.0

OWAUA_RULES_LLM_ENABLED=0
OWAUA_RULES_LLM_MODEL=openai/gpt-oss-20b
OWAUA_APPROVAL_CHANNEL=

# Storage and bounded resource settings. Ordinary raw history remains off until
# both the guild and individual user opt in, and expires by 30 days. The exact
# archive allowlist is a deliberate exception: accessible text is backfilled
# and retained without media or emoji. It is empty by default.
OWAUA_DB=owaua.db
OWAUA_RETENTION_DAYS=30
OWAUA_ARCHIVE_GUILD_IDS=
OWAUA_IMPORT_MAX_BYTES=2000000
OWAUA_CHAT_MIN_INTERVAL=2.5

# General bot behavior.
OWAUA_PREFIX=!
OWAUA_BLOCKED_USERS=
OWAUA_REFLECT_BATCH=15
OWAUA_MEMORY_TOPK=24
OWAUA_MEMORY_EXTRACT_PER_TURN=4
OWAUA_KB_TOPK=6
OWAUA_CHANNEL_CONTEXT=10
OWAUA_CONVO_TURNS=20
OWAUA_MEMORY_SOFT_CAP=200
OWAUA_LESSONS_IN_PROMPT=12
OWAUA_LURK_MIN_SECONDS=900
OWAUA_LURK_IDLE_SECONDS=600
OWAUA_LURK_MODEL=ix:deepseek-v4-flash-0731
OWAUA_EMBED_COLOR=0x5865F2
# Optional: OWAUA_PERSONA overrides the entire built-in persona. Omit it to
# retain the default rather than assigning an empty value.
