# Copy this file to .env. Keep .env private and never commit it.
DISCORD_TOKEN=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
# Optional provider-specific persona overrides; paths are relative to the project root.
GPT_PERSONA_FILE=gpt_persona.py
DEEPSEEK_PERSONA_FILE=deepseek_persona.py
PERSONA_FILE=persona.py
OPENAI_BASE_URL=https://api.openai.com/v1
MAX_OUTPUT_TOKENS=100
# Cheaper providers get tighter defaults because their prompt tokenization and
# occasional reasoning overhead can make a request more expensive overall.
NON_GPT_MAX_OUTPUT_TOKENS=80
MAX_CONTEXT_TURNS=6
# Approximate input budget; older turns are dropped when this is exceeded.
MAX_INPUT_TOKENS=4000
NON_GPT_MAX_CONTEXT_TURNS=3
NON_GPT_MAX_INPUT_TOKENS=2400
MAX_MESSAGE_CHARS=8000
MAX_ATTACHMENTS=4
MAX_ATTACHMENT_FILENAME_CHARS=200
MEMORY_DB=data/memory.sqlite3
MEMORY_SUMMARY_MIN_MESSAGES=6
MEMORY_SUMMARY_BATCH=60
MEMORY_MODEL=gpt-5.6-luna
MEMORY_SUMMARY_MAX_INPUT_TOKENS=2400
MEMORY_SUMMARY_MAX_OUTPUT_TOKENS=300
# 0 keeps memory until the database is manually removed.
MEMORY_RETENTION_DAYS=0
OPENAI_REQUEST_RETRIES=1
OPENAI_REQUEST_TIMEOUT=60
# Fail closed when the moderation request does not complete successfully.
OPENAI_MODERATION_TIMEOUT=15
# Temporary repeat-abuse control, separate from the normal per-user request limiter.
MODERATION_ABUSE_MAX_FLAGGED=3
MODERATION_ABUSE_WINDOW=300
MODERATION_ABUSE_BLOCK_SECONDS=900
RATE_LIMIT_REQUESTS=25
RATE_LIMIT_WINDOW=45
LOG_LEVEL=INFO
