DISCORD_TOKEN=
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
# Full mode uses this native OpenAI Responses API model.
OPENAI_FULL_MODEL=gpt-5.6-luna
# Full-mode DeepSeek uses the official DeepSeek API; the other non-GPT
# full-mode selections use Perplexity's API.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4.1-flash
DEEPSEEK_FULL_MODEL=deepseek-v4.1-flash
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
# Set to 1 on a Mac to disable every cloud AI provider and use the local model only.
OWAUA_LOCAL_ONLY=0
# DeepGrove Maple's MLX server exposes an OpenAI-compatible API.
OWAUA_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
OWAUA_LOCAL_MODEL=default_model
# Legacy Ollama names are accepted as fallbacks by the runtime.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=gpt-oss:20b
OWAUA_LOCAL_AI_ROOT=/Users/ckazro/mlx-lm-deepgrove
OWAUA_LOCAL_AI_MODEL_PATH=/Users/ckazro/mlx-lm-deepgrove/maple-2bit-mlx
GEMINI_MODEL=google/gemini-3.5-flash-lite
# Temporary kill switch: when enabled, all AI routes and model-selection
# commands use GEMINI_MODEL only.
OWAUA_GEMINI_ONLY=0
CLAUDE_FULL_MODEL=anthropic/claude-haiku-4-5
GEMINI_FULL_MODEL=google/gemini-3.5-flash-lite
GLM_FULL_MODEL=zai/glm-5.3-flash

# Operator IDs; ordinary chat users cannot change these or bypass API quotas.
BOT_OWNER_IDS=1172433512364769342
BOT_BLOCKED_USER_IDS=
# Empty allows all invited guilds; list IDs to restrict access.
BOT_ALLOWED_GUILD_IDS=
BOT_ALLOW_DMS=0
BOT_MAX_INFLIGHT=3
# JSONL audit log for every !music attempt. Relative paths are resolved from the repo.
MUSIC_AUDIT_LOG=data/music-audit.jsonl

# Optional free Cloudflare extras. Hangout chat uses AI Gateway when both IDs
# are set; full mode, music, and Discord stay on the host. A Cloudflare outage
# falls back to the same provider. Leave empty to talk to providers directly.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_GATEWAY=
CLOUDFLARE_AI_GATEWAY_TOKEN=
CLOUDFLARE_LOG_URL=
CLOUDFLARE_LOG_TOKEN=

# Durable rolling attempt caps shared by ALL providers. Zero blocks AI calls.
# These are counts, not currency amounts. Failed/cancelled attempts count.
API_REQUESTS_PER_MINUTE=12
API_REQUESTS_PER_USER_DAY=30
API_REQUESTS_PER_GUILD_DAY=100
API_REQUESTS_PER_DAY=200
API_REQUESTS_LIFETIME=1000

# Full-mode allowlist users get more per-user room, but still share the guild,
# global daily, and lifetime ceilings above. These are not unlimited.
FULL_MODE_REQUESTS_PER_MINUTE=24
FULL_MODE_REQUESTS_PER_USER_DAY=100
