DISCORD_TOKEN=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
MISTRAL_API_KEY=
KLIPY_API_KEY=
# Sightengine AI image detection. When both credentials are set, the bot deletes
# any message containing an image whose AI-generated confidence meets the threshold.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
AI_IMAGE_DETECTION_THRESHOLD=0.90
AI_IMAGE_DETECTOR_TIMEOUT=15
GPT_PERSONA_FILE=personas/gpt_persona.py
DEEPSEEK_PERSONA_FILE=personas/deepseek_persona.py
PERSONA_FILE=personas/persona.py
OPENAI_BASE_URL=https://api.openai.com/v1
# OpenAI Fast mode (2x token price, much lower latency). Use `default` to turn it off.
OPENAI_SERVICE_TIER=fast
# Mistral Priority when the key has it; falls back to standard. Use `standard_only` to skip.
MISTRAL_SERVICE_TIER=auto
STREAM_RESPONSES=true
STREAM_EDIT_INTERVAL=0.45
OPENAI_CONNECT_TIMEOUT=4
MAX_OUTPUT_TOKENS=100
NON_GPT_MAX_OUTPUT_TOKENS=80
MAX_CONTEXT_TURNS=6
MAX_INPUT_TOKENS=4000
NON_GPT_MAX_CONTEXT_TURNS=3
NON_GPT_MAX_INPUT_TOKENS=2400
MAX_MESSAGE_CHARS=8000
MAX_ATTACHMENTS=4
MAX_ATTACHMENT_FILENAME_CHARS=200
MEMORY_DB=data/memory.sqlite3
MEMORY_SUMMARY_MIN_MESSAGES=6
MEMORY_SUMMARY_BATCH=60
MEMORY_MODEL=gpt-5.6-luna
MEMORY_SUMMARY_MAX_INPUT_TOKENS=2400
MEMORY_SUMMARY_MAX_OUTPUT_TOKENS=300
MEMORY_RETENTION_DAYS=0
OPENAI_REQUEST_RETRIES=1
OPENAI_REQUEST_TIMEOUT=60
RATE_LIMIT_REQUESTS=25
RATE_LIMIT_WINDOW=45
LOG_LEVEL=INFO
