DISCORD_TOKEN=
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
# Full mode uses this native OpenAI Responses API model.
OPENAI_FULL_MODEL=gpt-5.6-terra

# Operator IDs; ordinary chat users cannot change these or bypass API quotas.
# Allowlisted full mode is exempt from attempt ceilings; pause still applies.
BOT_OWNER_IDS=1172433512364769342
BOT_BLOCKED_USER_IDS=
# Empty allows all invited guilds; list IDs to restrict access.
BOT_ALLOWED_GUILD_IDS=
BOT_ALLOW_DMS=0
BOT_MAX_INFLIGHT=3
# JSONL audit log for every !music attempt. Relative paths are resolved from the repo.
MUSIC_AUDIT_LOG=data/music-audit.jsonl

# Optional free Cloudflare extras. Hangout chat uses AI Gateway when both IDs
# are set; full mode, music, and Discord stay on the host. A Cloudflare outage
# falls back to the same provider. Leave empty to talk to providers directly.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_GATEWAY=
CLOUDFLARE_AI_GATEWAY_TOKEN=
CLOUDFLARE_LOG_URL=
CLOUDFLARE_LOG_TOKEN=

# Durable rolling attempt caps shared by ALL providers. Zero blocks AI calls.
# These are counts, not currency amounts. Failed/cancelled attempts count.
API_REQUESTS_PER_MINUTE=12
API_REQUESTS_PER_USER_DAY=30
API_REQUESTS_PER_GUILD_DAY=100
API_REQUESTS_PER_DAY=200
API_REQUESTS_LIFETIME=1000
